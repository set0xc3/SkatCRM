package components

import "github.com/set0xc3/htmx/internal/model"

templ Sidebar(model_ctx model.Context) {
<aside class="rounded-[5px] w-[150px] min-h-screen bg-white p-[8px] m-0">
	<ul class="flex flex-col m-0 p-0 gap-[5px]">
		for _, item := range model_ctx.SidebarItems {
		<li>
			if item.IsHot == true {
			<button
				class={ "bg-[#F0F8FF] outline outline-[1px] outline-[#7FB2FF] focus:bg-[#F0F8FF] focus:border-[#7FB2FF] active:bg-[#F0F8FF] active:border-[#7FB2FF] py-[5px] flex items-center h-[28px] rounded-[5px] pl-[5px] min-w-full text-sm gap-[8px]"
				} hx-get={ "/" + item.URL } hx-push-url={ "/" + item.URL } hx-swap="innerHTML" hx-target="body">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={ item.Icon }></path>
				</svg>
				{ item.Name }
			</button>
			} else {
			<button
				class={ "bg-[#F0F1F2] py-[5px] flex items-center h-[28px] rounded-[5px] pl-[5px] min-w-full text-sm gap-[8px]" }
				hx-get={ "/" + item.URL } hx-push-url={ "/" + item.URL } hx-swap="innerHTML" hx-target="body">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={ item.Icon }></path>
				</svg>
				{ item.Name }
			</button>
			}
		</li>
		}
	</ul>
</aside>
}
