package cms

templ CMS_Navbar() {
<!-- Navbar -->
<nav class="h-[24px] bg-base-200 flex items-center bg-white">
	<ul class="menu lg:menu-horizontal flex items-center justify-start h-full m-0 p-0 m-0">
		<li class="h-full">
			<a class="rounded-none text-center flex items-center justify-center h-full m-0 p-0 p-[5px]">File</a>
		</li>
		<li class="h-full">
			<a class="rounded-none text-center flex items-center justify-center h-full m-0 p-0 p-[5px]">Edit</a>
		</li>
		<li class="h-full">
			<a class="rounded-none text-center flex items-center justify-center h-full m-0 p-0 p-[5px]">Help</a>
		</li>
	</ul>
</nav>
}

templ CMS_Sidebar() {
<!-- Sidebar -->
<aside class="menu bg-base-200 rounded-[5px] w-[150px] h-screen bg-white">
	<ul class="flex flex-col m-0 p-0 gap-[5px]">
		<li>
			<a href="#" class="focus py-2 flex items-center h-[28px] rounded-[5px] pl-[5px]">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
						d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z">
					</path>
				</svg>
				Клиенты
			</a>
		</li>
		<li>
			<a href="#" class="focus py-2 flex items-center h-[28px] rounded-[5px] pl-[5px]">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
						d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z">
					</path>
				</svg>
				Звонки
			</a>
		</li>
		<li>
			<a href="#" class="focus py-2 flex items-center h-[28px] rounded-[5px] pl-[5px]">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 
						0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
				</svg>
				Заявки
			</a>
		</li>
		<li>
			<a href="#" class="focus py-2 flex items-center h-[28px] rounded-[5px] pl-[5px]">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
						d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605">
					</path>
				</svg>
				Отчёты
			</a>
		</li>
	</ul>
</aside>
}

templ IndexPage() {
<!DOCTYPE html>
<html data-theme="light" lang="en">

<head>
	<meta charset="utf-8" />
	<title>MySite</title>
	<link href="css/tw.css" rel="stylesheet" />
	<script src="js/htmx.min.js"></script>
</head>

<body class="flex flex-col h-full gap-[2px] bg-[#CDD2D6]">
	@CMS_Navbar()
	<div class="flex flex-1 gap-[2px]">
		@CMS_Sidebar()
		<!-- Main Content -->
		<main class="bg-base-200 rounded-[5px] flex-1 p-4 gap-[2px] bg-white">
			<p>This is where the main content goes.</p>
		</main>
	</div>
</body>

</html>
}
