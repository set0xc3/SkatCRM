package pages

import "github.com/set0xc3/htmx/internal/api"

templ ProductsTable() {
<div class="overflow-x-auto">
	<table class="table">
		<!-- head -->
		<thead>
			<tr>
				<th></th>
				<th></th>
			</tr>
		</thead>
		<tbody hx-confirm="Вы уверены?" hx-target="closest tr">
			for _, item := range api.FetchProducts() {
			<tr>
				<td>{ item.Id }</td>
				<td>{ item.Id2 }</td>
				<td><button class="btn" hx-delete={ "/api/v1/product/" + item.Id }>Delete</button></td>
			</tr>
			}
		</tbody>
	</table>
</div>
}

templ ProductsPage() {
<!DOCTYPE html>
<html data-theme="light" lang="en">

<head>
	<meta charset="utf-8" />
	<title>MySite</title>
	<link href="css/tw.css" rel="stylesheet" />
	<script src="js/htmx.min.js"></script>
</head>

<body hx-boost="true">
	@ProductsTable()
</body>

</html>
}
